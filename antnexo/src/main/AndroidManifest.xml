<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- configChanges: rotating or resizing must not reload the page (and lose what the person typed) -->
        <activity
            android:name="com.antnexo.FeedbackActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density"
            android:exported="false"
            android:theme="@style/AntNexo.Sheet"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.antnexo.SignInActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
